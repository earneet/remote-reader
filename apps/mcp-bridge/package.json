{
  "name": "remote-reader-bridge",
  "version": "0.2.0",
  "type": "module",
  "description": "Local MCP bridge for Remote Reader — exposes the upload_document tool over stdio",
  "license": "MIT",
  "bin": {
    "remote-reader-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "check": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node'"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@remote-reader/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
