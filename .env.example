DATABASE_PATH=./data/app.db
DATA_DIR=./data/documents
BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
# 首次启动用：注册第一个管理员所必需的邀请码
INITIAL_INVITE_CODE=change-me
# 上传限制
MAX_UPLOAD_BYTES=5242880
# adapter-node 请求体上限（须 > MAX_UPLOAD_BYTES，否则大上传会被网关 413）。
# ⚠️ 必须是字节数（数字），adapter-node 不接受 "8MB" 这类带单位写法。
BODY_SIZE_LIMIT=8388608
# 速率限制（每 token 上传次数 / 窗口毫秒 / 每邮箱登录次数）
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
# 认证失败按 IP 限流（防无效 token 枚举，纵深防御）
AUTH_FAIL_RATE_LIMIT_MAX=30
# session 有效期（秒，默认 30 天）
SESSION_MAX_AGE=2592000
# ── 冷热分层归档（可选；全部留空 = 关闭分层，文档只存本地）──
# S3 兼容对象存储。七牛 Kodo 示例：endpoint=https://s3.<region>.qiniucs.com
# 同一配置通接 AWS S3 / Cloudflare R2 / MinIO / 阿里云 OSS S3 网关 / 腾讯 COS
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_REGION=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=
# MinIO 等自建服务常需 path-style 寻址；七牛/AWS/R2 保持 false
OBJECT_STORE_FORCE_PATH_STYLE=false
# 冷判定阈值：N 天未访问且未更新 → 自动归档到对象存储（默认 30）
COLD_TIER_AFTER_DAYS=30
